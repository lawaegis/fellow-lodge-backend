# =============================================================================
# Fellow Lodge Backend - environment template
# Copy this file to `.env` (or your platform's env vars) and fill in real values.
# NEVER commit the real `.env` / `.env.supabase.local` file.
#
# The active Spring profile is selected via SPRING_PROFILES_ACTIVE:
#   dev        -> in-memory H2, no configuration required (default)
#   supabase   -> Supabase PostgreSQL (recommended for deployment)
#   prod       -> generic PostgreSQL via DATABASE_URL / DATABASE_USERNAME / DATABASE_PASSWORD
# =============================================================================

# --- Active profile --------------------------------------------------------
SPRING_PROFILES_ACTIVE=supabase

# --- Supabase PostgreSQL (profile: supabase) --------------------------------
# Host:      aws-0-<region>.pooler.supabase.com  (Session pooler, port 5432)
#            db.<project-ref>.supabase.co        (Direct connection, port 5432)
# Username:  postgres.<project-ref>
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USERNAME=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_SSLMODE=require

# --- Generic PostgreSQL (profile: prod) -------------------------------------
# Can also be provided by managed platforms (Render/Railway) as DATABASE_URL.
DATABASE_URL=
DATABASE_USERNAME=
DATABASE_PASSWORD=

# --- Security (REQUIRED for prod/supabase profiles) -------------------------
# Generate with: openssl rand -base64 64
JWT_SECRET=

# --- Optional tuning ---------------------------------------------------------
# JWT_ACCESS_EXPIRATION=1800000
# JWT_REFRESH_EXPIRATION=604800000
# MAX_LOGIN_ATTEMPTS=5
# LOCK_DURATION_MINUTES=30
# SUPABASE_DB_POOL_SIZE=10
# SUPABASE_DB_MIN_IDLE=2
# UPLOAD_DIR=/data/uploads
# CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
