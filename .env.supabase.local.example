# ============================================================================
# LOCAL-ONLY Supabase credentials. NEVER COMMIT.
# Copy this file to `.env.supabase.local` and fill in the real values.
# (`.env.supabase.local` is gitignored, so it will never be pushed.)
#
# Source of truth: Supabase Dashboard -> Project Settings -> Database
#   -> "Connection string" -> Session pooler / Direct connection.
#
# RECOMMENDED (IPv4, works on most networks):
#   Host:  aws-0-<region>.pooler.supabase.com      (Session pooler, port 5432)
#   User:  postgres.<project-ref>
#
# FALLBACK (IPv6-only on some networks; your machine must have IPv6):
#   Host:  db.<project-ref>.supabase.co            (Direct, port 5432)
#   User:  postgres
# ============================================================================

SPRING_PROFILES_ACTIVE=supabase

SUPABASE_DB_HOST=aws-0-<region>.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USERNAME=postgres.<project-ref>
SUPABASE_DB_PASSWORD=your-database-password
SUPABASE_DB_SSLMODE=require

# REQUIRED for the supabase/prod profiles. Generate with: openssl rand -base64 64
JWT_SECRET=generate-a-64-byte-base64-secret

# --- Supabase Storage (optional for local dev; recommended for deployment) ---
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_STORAGE_BUCKETS=rooms,gallery,events,conferences,banners,menu,profiles,attractions,services,misc

# Optional tuning
# SUPABASE_DB_POOL_SIZE=10
# SUPABASE_DB_MIN_IDLE=2
